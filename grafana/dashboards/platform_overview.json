          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  FLOOR(\r\n    EXTRACT(EPOCH FROM (NOW() - MIN(latest.last_success_at))) / 3600.0\r\n  )::bigint AS \"Oldest\"\r\nFROM (\r\n  SELECT\r\n    fb.instance_key,\r\n    fb.database_key,\r\n    MAX(fb.backup_finish_at) AS last_success_at\r\n  FROM fact.fact_backup AS fb\r\n  WHERE fb.backup_type = 'FULL'\r\n    AND fb.backup_status = 'SUCCESS'\r\n    AND fb.backup_finish_at IS NOT NULL\r\n    AND (0 IN (${instance_key:csv})\r\n         OR fb.instance_key IN (${instance_key:csv}))\r\n    AND (0 IN (${database_key:csv})\r\n         OR fb.database_key IN (${database_key:csv}))\r\n  GROUP BY fb.instance_key, fb.database_key\r\n) AS latest;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
