ENVIRONMENT=development
APP_NAME=SQLServer-Monitoring-Platform-API
API_PORT=8000
DEBUG=false
FRONTEND_PORT=3001
APP_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
CORS_ORIGINS=["http://localhost:3001"]

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_GRAFANA_PASSWORD

AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=REPLACE_WITH_A_AIRFLOW_ADMIN_USER
AIRFLOW_ADMIN_PASSWORD=REPLACE_WITH_A_AIRFLOW_PASSWORD

SQLSERVER_SA_PASSWORD=REPLACE_WITH_A_SQLSERVER_SA_PASSWORD

SQLSERVER_HOST=REPLACE_WITH_A_SQLSERVER_HOST
SQLSERVER_PORT=REPLACE_WITH_A_SQLSERVER_PORT
SQLSERVER_USER=REPLACE_WITH_A_SQLSERVER_USER
SQLSERVER_PASSWORD=REPLACE_WITH_A_SQLSERVER_PASSWORD
SQLSERVER_DATABASE=REPLACE_WITH_A_SQLSERVER_DATABASE
SQLSERVER_INSTANCE_NAME=MSSQLSERVER
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_SERVER_CERTIFICATE=yes
SQLSERVER_CONNECTION_TIMEOUT=15

POSTGRES_HOST=REPLACE_WITH_A_POSTGRES_HOST_NAME
POSTGRES_PORT=REPLACE_WITH_A_POSTGRES_PORT
POSTGRES_HOST_PORT=REPLACE_WITH_A_POSTGRES_HOST_PORT
POSTGRES_DB=REPLACE_WITH_A_POSTGRES_DB_NAME
POSTGRES_USER=REPLACE_WITH_A_POSTGRES_USER
POSTGRES_PASSWORD=REPLACE_WITH_A_POSTGRES_PASSWORD
POSTGRES_PASSWORD_URLENCODED=REPLACE_WITH_A_POSTGRES_PASSWORD_URL_ENCODED

TARGET_INSTANCE_KEY=1
COLLECTOR_NAME=sqlserver-collector
COLLECTOR_VERSION=1.0.0
LOG_LEVEL=INFO

AIRFLOW_UID=50000
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__EXECUTOR=LocalExecutor