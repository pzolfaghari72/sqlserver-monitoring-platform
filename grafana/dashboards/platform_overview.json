          "rawSql": "WITH latest AS (SELECT DISTINCT ON (job_name) job_name, run_status AS last_status, run_start_at AS last_run_at, run_duration_seconds AS last_duration_seconds, message AS last_message, sqlagent_job_enabled FROM fact.fact_sqlagent_job ORDER BY job_name, run_start_at DESC NULLS LAST, sqlagent_job_key DESC), stats AS (SELECT job_name, COUNT(*) AS total_runs, COUNT(*) FILTER (WHERE run_status='SUCCESS') AS successful_runs, COUNT(*) FILTER (WHERE run_status='FAILED') AS failed_runs, COUNT(*) FILTER (WHERE run_status IN ('RETRY','CANCELED')) AS interrupted_runs, MAX(run_start_at) AS latest_run_at, ROUND(AVG(run_duration_seconds)::numeric, 1) AS avg_duration_seconds FROM fact.fact_sqlagent_job GROUP BY job_name) SELECT l.job_name, l.last_status, l.last_run_at, l.last_duration_seconds, s.total_runs, s.successful_runs, s.failed_runs, s.interrupted_runs, s.avg_duration_seconds, l.sqlagent_job_enabled, l.last_message FROM latest l JOIN stats s USING (job_name) ORDER BY CASE l.last_status WHEN 'FAILED' THEN 1 WHEN 'RETRY' THEN 2 WHEN 'CANCELED' THEN 3 ELSE 4 END, l.job_name",
          "refId": "A"
