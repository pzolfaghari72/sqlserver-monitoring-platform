      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(f.collected_at, $__interval), i.instance_name || ' / ' || m.metric_name AS metric, AVG(f.metric_value_numeric)::double precision AS value FROM fact.fact_server_metric AS f JOIN dimension.dim_instance AS i ON i.instance_key = f.instance_key JOIN dimension.dim_metric AS m ON m.metric_key = f.metric_key WHERE $__timeFilter(f.collected_at) AND f.status = 'success' AND f.metric_value_numeric IS NOT NULL AND m.category = 'server' AND (0 IN (${instance_key:csv}) OR f.instance_key IN (${instance_key:csv})) AND m.metric_code = ${metric_code:sqlstring} GROUP BY 1, 2 ORDER BY 1, 2;",
          "refId": "A"
        }
      ],
      "title": "Server Metric Trend",
      "type": "timeseries"
    },
