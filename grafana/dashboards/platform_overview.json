      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT a.severity,a.status,a.alert_name,s.server_name,i.instance_name,d.database_name,m.metric_code,ROUND(a.current_value::numeric,2) AS current_value,ROUND(a.threshold_value::numeric,2) AS threshold_value,a.occurrence_count,a.first_seen_at,a.last_seen_at,a.message FROM monitoring.alert_event a JOIN dimension.dim_instance i ON i.instance_key=a.instance_key JOIN dimension.dim_server s ON s.server_key=i.server_key LEFT JOIN dimension.dim_database d ON d.database_key=a.database_key LEFT JOIN dimension.dim_metric m ON m.metric_key=a.metric_key WHERE a.status IN ('open','acknowledged') ORDER BY CASE a.severity WHEN 'critical' THEN 1 WHEN 'warning' THEN 2 ELSE 3 END,a.last_seen_at DESC",
          "refId": "A"
        }
      ],
      "title": "Active Alert Details",
      "type": "table"
